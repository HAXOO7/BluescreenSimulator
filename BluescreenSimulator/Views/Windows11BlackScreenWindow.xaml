<Window x:Class="BluescreenSimulator.Views.Windows11BlackScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 11 Stop Error Simulation" Background="Black" Foreground="#F5F5F5"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Cursor="None" KeyDown="Window_KeyDown"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="36,0,36,0" x:Name="MainContent">
            <TextBlock x:Name="MessageText" Text="{Binding Message}" TextAlignment="Center"
                       FontFamily="Segoe UI" FontSize="28" FontWeight="Normal"
                       TextWrapping="Wrap" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ProgressText" Margin="0,24,0,0" TextAlignment="Center"
                       FontFamily="Segoe UI" FontSize="26" Text="0% complete"/>
        </StackPanel>
        <StackPanel Grid.Row="1" x:Name="DiagnosticText" HorizontalAlignment="Center"
                    Margin="20,0,20,22">
            <TextBlock x:Name="StopCodeText" TextAlignment="Center" FontFamily="Segoe UI"
                       FontSize="14" TextWrapping="Wrap"/>
            <TextBlock x:Name="FaultyDriverText" TextAlignment="Center" FontFamily="Segoe UI"
                       FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>
